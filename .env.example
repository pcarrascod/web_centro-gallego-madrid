# Copia este archivo como .env.local y rellénalo con los datos de tu proyecto
# de Supabase: Project Settings → API Keys (y Data API para la URL).
#
# .env.local no se sube a GitHub. En Netlify, estas mismas tres variables se
# ponen en Site configuration → Environment variables.

# La dirección del proyecto: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# La clave pública («publishable», empieza por sb_publishable_). Sirve para
# entrar y salir. En proyectos antiguos se llama «anon».
SUPABASE_PUBLISHABLE_KEY=

# La clave secreta («secret», empieza por sb_secret_). Lo puede todo: no la
# compartas ni la pegues en ningún sitio más. En proyectos antiguos se llama
# «service_role».
SUPABASE_SECRET_KEY=
